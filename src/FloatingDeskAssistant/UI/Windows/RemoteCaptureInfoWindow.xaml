<Window x:Class="FloatingDeskAssistant.UI.Windows.RemoteCaptureInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Trigger" ShowInTaskbar="False"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White" Foreground="#FF202428">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/LightTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="12"
            CornerRadius="4"
            BorderBrush="#FFD8DEE2"
            BorderThickness="1"
            Background="#FFFFFFFF"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Phone Trigger QR"
                       Foreground="#FF202428"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="#FF616B73"
                       TextWrapping="Wrap"
                       Text="Use your phone camera or browser to open this page. Then tap one button to trigger host desktop capture while your mouse stays inside VMware." />

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="14"
                    Background="White"
                    CornerRadius="4"
                    HorizontalAlignment="Center">
                <Image x:Name="QrImage"
                       Width="240"
                       Height="240"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="Primary URL"
                           Foreground="#FF616B73"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBox x:Name="PrimaryUrlTextBox"
                         Margin="0,6,0,0"
                         IsReadOnly="True"
                         BorderBrush="#FFD8DEE2"
                         Background="#FFF7F8F9"
                         Foreground="#FF202428"
                         TextWrapping="Wrap"
                         Padding="10,8" />

                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,10,0,0"
                           Foreground="#FF616B73"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="OtherUrlsTextBlock"
                           Margin="0,10,0,0"
                           Foreground="#FF315F86"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Padding="12,8"
                        Margin="0,0,8,0"
                        Content="Copy URL"
                        Click="CopyUrlButton_OnClick" />
                <Button Padding="12,8"
                        Margin="0,0,8,0"
                        Content="Open Page"
                        Click="OpenPageButton_OnClick" />
                <Button Padding="12,8"
                        Content="Close"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
